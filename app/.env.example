# Copy to .env.local and fill in values from Supabase → Project Settings → API.
# Only public values belong here. Never add the service-role key with a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Base URL used in auth e-mail links (confirmation, password recovery).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
