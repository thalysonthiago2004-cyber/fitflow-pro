# Copy to .env.local and fill in values from Supabase → Project Settings → API.
# Only public values belong in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Base URL used in auth e-mail links (confirmation, password recovery).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional ---------------------------------------------------------------------
# Firebase Authentication (login, e-mail verification, password reset). Public
# web config from Firebase console → Project settings → Your apps. Leave empty
# to use Supabase e-mail/password instead.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Closed beta: "1" asks trainers for the beta code on sign-up. The code itself is
# checked by the database (private.settings 'beta_code_sha256'), not here.
BETA_SIGNUP_REQUIRED=
# Web Push (generate with: npx web-push generate-vapid-keys).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Reminder scheduler: the bearer secret pg_cron sends to /api/cron/reminders,
# and the server-only key the endpoint uses. Never prefix these with NEXT_PUBLIC_.
CRON_SECRET=
SUPABASE_SECRET_KEY=
# Error monitoring (Sentry). Empty disables it.
NEXT_PUBLIC_SENTRY_DSN=
# Shown on the privacy and terms pages for data-subject requests.
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
